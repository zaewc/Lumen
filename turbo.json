{
  "$schema": "./node_modules/turbo/schema.json",
  "agentGuidance": false,
  "tasks": {
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    },
    "gen-check": {
      "outputs": []
    },
    "test": {
      "outputs": []
    },
    "@lumen/web#test": {
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/crates/lumen-policy/src/explain.rs"],
      "outputs": []
    },
    "fsd": {
      "outputs": []
    },
    "build": {
      "outputs": ["dist/**"]
    },
    "bundle": {
      "outputs": []
    }
  }
}
