---
// GitHub Pages serves this page for any missing path, so its links are
// absolute to the project site (https://zaewc.github.io/Lumen/).
import { LOCALE_NAMES, LOCALES, localePath, messages } from "../i18n";
import Base from "../layouts/Base.astro";

const base = import.meta.env.BASE_URL;
---

<Base locale="ko" notFound>
  <main class="wrap intro">
    <h1>{messages.ko.notFound.title}</h1>
    {LOCALES.map((locale) => (
      <p class="lead" lang={locale}>
        <a href={localePath(locale, base)}>{LOCALE_NAMES[locale]} · {messages[locale].notFound.home}</a>
      </p>
    ))}
  </main>
</Base>
