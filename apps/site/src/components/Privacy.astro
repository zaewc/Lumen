---
import { messages } from "../i18n";
import type { Locale } from "../i18n/types";

interface Props {
  locale: Locale;
}

const t = messages[Astro.props.locale];
---

<section aria-labelledby="privacy-title">
  <h2 id="privacy-title">{t.privacy.title}</h2>
  <p>{t.privacy.local}</p>
  <p><strong>{t.privacy.aiTitle}</strong> {t.privacy.ai}</p>
</section>
