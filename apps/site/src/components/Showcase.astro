---
// What the app looks like and what it does: one capture under the hero and
// the list of what Lumen does.
import { messages } from "../i18n";
import type { Locale } from "../i18n/types";
import AppWindow from "./AppWindow.astro";
import "../styles/showcase.css";

interface Props {
  locale: Locale;
  part: "capture" | "features";
}

const { locale, part } = Astro.props;
const t = messages[locale];
const screens = `${import.meta.env.BASE_URL}screens/`;
---

{part === "capture" && (
  <figure class="capture">
    <AppWindow src={`${screens}clean-up-${locale}.webp`} alt={t.showcase.main} width={1600} height={1143} eager />
  </figure>
)}
{part === "features" && (
  <section class="features" aria-labelledby="features-title">
    <h2 id="features-title">{t.features.title}</h2>
    <dl>
      {t.features.items.map((item) => (
        <div>
          <dt>{item.title}</dt>
          <dd>{item.text}</dd>
        </div>
      ))}
    </dl>
  </section>
)}
