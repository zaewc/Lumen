---
// What the app looks like, how to use it and what it does: one capture under
// the hero, three steps, and the list of what Lumen does.
import { messages, screenshotLocale } from "../i18n";
import type { Locale } from "../i18n/types";
import AppWindow from "./AppWindow.astro";
import "../styles/showcase.css";

interface Props {
  locale: Locale;
  part: "capture" | "steps" | "features";
}

const { locale, part } = Astro.props;
const t = messages[locale];
const captureLocale = screenshotLocale(locale);
const screens = `${import.meta.env.BASE_URL}screens/`;
---

{part === "capture" && (
  <figure class="capture">
    <AppWindow src={`${screens}clean-up-${captureLocale}.webp`} alt={t.showcase.main} width={1600} height={1143} eager />
  </figure>
)}
{part === "steps" && (
  <section class="steps" aria-labelledby="steps-title">
    <h2 id="steps-title">{t.howTo.title}</h2>
    <ol>
      {t.howTo.steps.map((step) => (
        <li>
          <h3>{step.title}</h3>
          <p>{step.text}</p>
        </li>
      ))}
    </ol>
  </section>
)}
{part === "features" && (
  <section class="features" aria-labelledby="features-title">
    <h2 id="features-title">{t.features.title}</h2>
    <dl>
      {t.features.items.map((item) => (
        <div>
          <dt>{item.title}</dt>
          <dd>{item.text}</dd>
        </div>
      ))}
    </dl>
  </section>
)}
