---
// The download page, in one language. The release lookup (src/scripts/site.ts)
// is bundled by Astro into a file; it reads its strings from <body data-strings>.
import { REPO_URL } from "../data/release";
import { messages } from "../i18n";
import type { Locale } from "../i18n/types";
import Base from "../layouts/Base.astro";
import Downloads from "./Downloads.astro";
import Hero from "./Hero.astro";
import Showcase from "./Showcase.astro";
import "../styles/story.css";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = messages[locale];
const illustrations = ["protect", "evidence", "local"];
const base = import.meta.env.BASE_URL;
---

<Base locale={locale}>
  <Hero locale={locale} />
  <Showcase locale={locale} part="capture" />
  <Showcase locale={locale} part="features" />
  <div class="story">
    {t.trust.items.map((item, index) => (
      <section class="chapter" aria-labelledby={`principle-${index}`}>
        <div class="chapter-layout">
          <div class="chapter-content">
            <h2 id={`principle-${index}`}>{item.headline.map((line) => <span>{line}</span>)}</h2>
            <p>{item.text}</p>
            {index === t.trust.items.length - 1 && (
              <a class="architecture-link" href={`${REPO_URL}/blob/main/docs/architecture/system.md`}>{t.trust.more}<span aria-hidden="true"> →</span></a>
            )}
          </div>
          <img
            class="chapter-art"
            src={`${base}art/${illustrations[index] ?? "protect"}.webp`}
            alt=""
            aria-hidden="true"
            width="1254"
            height="1254"
            loading="lazy"
            decoding="async"
          />
        </div>
      </section>
    ))}
  </div>
  <Downloads locale={locale} />
  <script>
    import "../scripts/site.ts";
  </script>
</Base>
