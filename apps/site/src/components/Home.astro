---
// The download page, in one language. The release lookup (src/scripts/site.ts)
// is bundled by Astro into a file; it reads its strings from <body data-strings>.
import { REPO_URL } from "../data/release";
import { messages } from "../i18n";
import type { Locale } from "../i18n/types";
import Base from "../layouts/Base.astro";
import Hero from "./Hero.astro";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = messages[locale];
---

<Base locale={locale}>
  <Hero locale={locale} />
  <section class="principles" aria-labelledby="safety-title">
    <h2 id="safety-title">{t.trust.title}</h2>
    <dl>
      {t.trust.items.map((item) => <div><dt>{item.title}</dt><dd>{item.text}</dd></div>)}
    </dl>
    <p class="architecture-link"><a href={`${REPO_URL}/blob/main/docs/architecture/system.md`}>{t.trust.more}</a></p>
  </section>
  <script>
    import "../scripts/site.ts";
  </script>
</Base>
