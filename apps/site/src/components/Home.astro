---
// The download page, in one language. The release lookup (src/scripts/site.ts)
// is bundled by Astro into a file; it reads its strings from <body data-strings>.
import type { Locale } from "../i18n/types";
import Base from "../layouts/Base.astro";
import Downloads from "./Downloads.astro";
import Faq from "./Faq.astro";
import Hero from "./Hero.astro";
import HowItWorks from "./HowItWorks.astro";
import InstallGuides from "./InstallGuides.astro";
import LeftAlone from "./LeftAlone.astro";
import Privacy from "./Privacy.astro";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<Base locale={locale}>
  <Hero locale={locale} />
  <HowItWorks locale={locale} />
  <LeftAlone locale={locale} />
  <Privacy locale={locale} />
  <Downloads locale={locale} />
  <InstallGuides locale={locale} />
  <Faq locale={locale} />
  <script>
    import "../scripts/site.ts";
  </script>
</Base>
