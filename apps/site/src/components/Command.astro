---
// A shell command with a copy button. In `text`, each <version> becomes a
// placeholder that the release lookup fills in; without `text`, the slot is
// the command.
interface Props {
  id: string;
  copy: string;
  text?: string;
}

const { id, copy, text } = Astro.props;
const parts = text?.split("<version>") ?? [];
---

<div class="cmd">
  <pre><code id={id}>{
    text === undefined ? <slot /> : parts.map((part, index) => index === 0 ? part : [<span data-version>&lt;version&gt;</span>, part])
  }</code></pre>
  <button type="button" class="copy js-only" data-copy={id}>{copy}</button>
</div>
