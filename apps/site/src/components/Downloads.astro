---
// The download section: the release status, a row per platform, and the
// other files and verification steps below them.
import { PLATFORMS, RELEASES_URL } from "../data/release";
import { messages } from "../i18n";
import type { Locale } from "../i18n/types";
import InstallGuides from "./InstallGuides.astro";
import OtherFiles from "./OtherFiles.astro";
import PlatformRow from "./PlatformRow.astro";
import Rich from "./Rich.astro";
import Verify from "./Verify.astro";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = messages[locale];
---

<details class="download-choices disclosure" id="download">
  <summary>{t.download.title}</summary>
  <div class="download-body">
  <p class="status" id="release-status" aria-live="polite">
    <span class="no-js"><Rich text={t.download.noScript} /></span>
    <span class="js-only">{t.download.checking}</span>
  </p>
  <ul class="platforms">
    {PLATFORMS.map((platform) => <PlatformRow locale={locale} platform={platform} fallback={RELEASES_URL} />)}
  </ul>
  <InstallGuides locale={locale} />
  <OtherFiles locale={locale} />
  <Verify locale={locale} />
  </div>
</details>
