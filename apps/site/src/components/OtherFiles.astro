---
import { RELEASES_URL } from "../data/release";
import { messages } from "../i18n";
import type { Locale } from "../i18n/types";
import Rich from "./Rich.astro";

interface Props {
  locale: Locale;
}

const t = messages[Astro.props.locale];
---

<details class="disclosure" id="files">
  <summary>{t.files.summary}</summary>
  <div class="body">
    <p><Rich text={t.files.intro} /></p>
    <p class="no-js"><a href={RELEASES_URL}>{t.client.allFiles}</a></p>
    <div class="table-scroll js-only" id="file-list"></div>
  </div>
</details>
