{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "The main window may call Lumen's own commands and nothing else: no plugins, no file system, no shell (ADR-0004).",
  "windows": ["main"],
  "permissions": [
    "allow-scan",
    "allow-assess",
    "allow-plan",
    "allow-execute",
    "allow-held",
    "allow-restore",
    "allow-finalize",
    "allow-ai-settings",
    "allow-set-ai-review",
    "allow-set-ai-key",
    "allow-disk",
    "allow-open-full-disk-access",
    "allow-check-update",
    "allow-install-update",
    "allow-run-tool-command"
  ]
}
