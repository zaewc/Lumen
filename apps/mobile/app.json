{
  "expo": {
    "name": "Lumen",
    "slug": "lumen",
    "version": "0.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "dev.lumen.mobile",
      "supportsTablet": true,
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Lumen reads your photo library to find near-duplicate photos for you to review. Nothing is changed without your confirmation.",
        "BGTaskSchedulerPermittedIdentifiers": ["dev.lumen.mobile.analyze"]
      }
    },
    "android": {
      "package": "dev.lumen.mobile",
      "permissions": ["android.permission.READ_MEDIA_IMAGES"]
    }
  }
}
