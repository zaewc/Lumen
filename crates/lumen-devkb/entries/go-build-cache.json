{
  "id": "go-build-cache",
  "tool": "Go",
  "locations": [
    {
      "platforms": ["macos"],
      "root": { "kind": "home" },
      "path": "Library/Caches/go-build"
    },
    {
      "platforms": ["linux"],
      "root": { "kind": "home" },
      "path": ".cache/go-build"
    },
    {
      "platforms": ["linux"],
      "root": { "kind": "env_var", "name": "XDG_CACHE_HOME" },
      "path": "go-build"
    },
    {
      "platforms": ["windows"],
      "root": { "kind": "local_app_data" },
      "path": "go-build"
    },
    {
      "platforms": ["macos", "windows", "linux"],
      "root": { "kind": "env_var", "name": "GOCACHE" },
      "path": ""
    }
  ],
  "safety_class": "self_managed",
  "regeneration": { "effort": "minutes", "network": false },
  "official_action": {
    "program": "go",
    "args": ["clean", "-cache"],
    "dry_run_args": ["clean", "-n", "-cache"]
  },
  "sources": [
    "https://pkg.go.dev/cmd/go#hdr-Build_and_test_caching",
    "https://pkg.go.dev/os#UserCacheDir",
    "https://pkg.go.dev/cmd/go#hdr-Remove_object_files_and_cached_files"
  ],
  "last_verified": "2026-10-13"
}
