{
  "id": "vscode-squirrel-update-staging",
  "tool": "Visual Studio Code",
  "locations": [
    {
      "platforms": ["macos"],
      "root": { "kind": "home" },
      "path": "Library/Caches/com.microsoft.VSCode.ShipIt",
