    "https://github.com/microsoft/vscode/blob/main/src/vs/platform/update/electron-main/updateService.darwin.ts",
    "https://github.com/Squirrel/Squirrel.Mac/blob/master/Squirrel/SQRLDirectoryManager.m",
    "https://github.com/Squirrel/Squirrel.Mac/blob/master/Squirrel/SQRLShipItLauncher.m",
    "https://github.com/Squirrel/Squirrel.Mac/blob/master/Squirrel/SQRLUpdater.m"
  ],
  "last_verified": "2026-10-31"
}
