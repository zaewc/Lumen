    {
      "platforms": ["windows"],
      "root": { "kind": "roaming_app_data" },
      "path": "Claude/Code Cache"
    },
    {
      "platforms": ["windows"],
      "root": { "kind": "roaming_app_data" },
      "path": "Claude/GPUCache"
    },
    {
      "platforms": ["windows"],
