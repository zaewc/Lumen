    {
      "platforms": ["windows"],
      "root": { "kind": "roaming_app_data" },
      "path": "Claude/Partitions/*/Cache"
    },
    {
      "platforms": ["windows"],
      "root": { "kind": "roaming_app_data" },
      "path": "Claude/Partitions/*/Code Cache"
    },
    {
      "platforms": ["windows"],
      "root": { "kind": "roaming_app_data" },
      "path": "Claude/Partitions/*/GPUCache"
    },
    {
      "platforms": ["windows"],
      "root": { "kind": "roaming_app_data" },
      "path": "Claude/Partitions/*/DawnGraphiteCache"
    },
    {
      "platforms": ["windows"],
      "root": { "kind": "roaming_app_data" },
