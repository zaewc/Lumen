{
  "id": "notion-squirrel-update-staging",
  "tool": "Notion",
  "locations": [
    {
      "platforms": ["macos"],
      "root": { "kind": "home" },
      "path": "Library/Caches/notion.id.ShipIt",
      "kind": "directory"
    }
  ],
  "safety_class": "self_managed",
  "regeneration": { "effort": "minutes", "network": true },
  "sources": [
    "https://www.electronjs.org/docs/latest/api/auto-updater",
    "https://www.electron.build/docs/features/auto-update/",
    "https://github.com/electron-userland/electron-builder/blob/master/packages/electron-updater/src/MacUpdater.ts",
    "https://github.com/Squirrel/Squirrel.Mac/blob/master/Squirrel/SQRLDirectoryManager.m",
    "https://github.com/Squirrel/Squirrel.Mac/blob/master/Squirrel/SQRLShipItLauncher.m",
    "https://github.com/Squirrel/Squirrel.Mac/blob/master/Squirrel/SQRLUpdater.m"
  ],
  "last_verified": "2026-10-31"
}
