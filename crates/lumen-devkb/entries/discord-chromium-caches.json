{
  "id": "discord-chromium-caches",
  "tool": "Discord",
  "locations": [
    {
      "platforms": ["macos"],
      "root": { "kind": "home" },
      "path": "Library/Application Support/discord/Cache"
    },
    {
      "platforms": ["macos"],
      "root": { "kind": "home" },
      "path": "Library/Application Support/discord/Code Cache"
    },
    {
      "platforms": ["macos"],
      "root": { "kind": "home" },
      "path": "Library/Application Support/discord/GPUCache"
    },
    {
      "platforms": ["macos"],
      "root": { "kind": "home" },
      "path": "Library/Application Support/discord/DawnGraphiteCache"
    },
    {
      "platforms": ["macos"],
      "root": { "kind": "home" },
      "path": "Library/Application Support/discord/DawnWebGPUCache"
    },
    {
      "platforms": ["macos"],
      "root": { "kind": "home" },
      "path": "Library/Application Support/discord/Partitions/*/Cache"
    },
    {
      "platforms": ["macos"],
      "root": { "kind": "home" },
      "path": "Library/Application Support/discord/Partitions/*/Code Cache"
    },
    {
      "platforms": ["macos"],
      "root": { "kind": "home" },
      "path": "Library/Application Support/discord/Partitions/*/GPUCache"
    },
    {
      "platforms": ["macos"],
      "root": { "kind": "home" },
      "path": "Library/Application Support/discord/Partitions/*/DawnGraphiteCache"
    },
    {
      "platforms": ["macos"],
      "root": { "kind": "home" },
      "path": "Library/Application Support/discord/Partitions/*/DawnWebGPUCache"
    }
  ],
  "safety_class": "regenerable",
  "regeneration": { "effort": "seconds", "network": true },
  "sources": [
    "https://discord.com/blog/how-discord-seamlessly-upgraded-millions-of-users-to-64-bit-architecture",
    "https://www.electronjs.org/docs/latest/api/app",
    "https://www.electronjs.org/docs/latest/api/session",
    "https://github.com/electron/electron/blob/main/shell/browser/net/network_context_service.cc",
    "https://github.com/electron/electron/blob/main/shell/browser/electron_browser_context.cc",
    "https://github.com/chromium/chromium/blob/main/chrome/common/chrome_constants.h",
    "https://www.chromium.org/developers/design-documents/network-stack/disk-cache/",
    "https://github.com/chromium/chromium/blob/main/content/browser/storage_partition_impl.cc",
    "https://github.com/chromium/chromium/blob/main/gpu/ipc/common/gpu_disk_cache_type.cc"
  ],
  "last_verified": "2026-10-26"
}
