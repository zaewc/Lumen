{
  "openapi": "3.1.0",
  "info": {
    "title": "Lumen local API",
    "description": "View models for Lumen's desktop UI and browser dashboard (ADR-0011).",
    "license": {
      "name": "Apache-2.0",
      "identifier": "Apache-2.0"
    },
    "version": "0.7.0"
  },
  "paths": {},
  "components": {
    "schemas": {
      "AiKeySourceView": {
        "type": "string",
        "description": "Where the judge's key comes from (ADR-0042); never the key itself.",
        "enum": [
          "builtin",
          "stored"
        ]
      },
      "AiKeyView": {
        "type": "string",
        "description": "Which service the judge's key is for; never the key itself.",
        "enum": [
          "jeb",
          "openrouter",
          "none"
        ]
      },
      "AiNoteView": {
        "type": "object",
        "description": "An AI note on a review item: only a closed kind and a confidence, never\nmodel text.",
        "required": [
          "kind",
          "confidence"
        ],
        "properties": {
          "confidence": {
            "$ref": "#/components/schemas/ConfidenceView",
            "description": "How sure AI review was."
          },
          "kind": {
            "$ref": "#/components/schemas/ItemKindView",
            "description": "What the item most likely is."
          }
        }
      },
      "AiSettingsView": {
        "type": "object",
        "description": "Whether AI review is on (ADR-0037), and which key it would use.",
        "required": [
          "enabled",
          "consented_at",
          "key",
          "key_source"
        ],
        "properties": {
          "consented_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time",
            "description": "When the user last turned it on; `null` if never."
          },
          "enabled": {
            "type": "boolean",
            "description": "Whether assessments ask the judge about proposed quarantines."
          },
          "key": {
            "$ref": "#/components/schemas/AiKeyView",
            "description": "Which service the key it would use is for; `none` without a key."
          },
          "key_source": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/AiKeySourceView",
                "description": "Where that key comes from; `null` without a key."
              },
              {
                "type": "null"
              }
            ]
          }
        }
      },
      "AssessProgressView": {
        "type": "object",
        "description": "Advisory progress, without paths or contents. Never an action input.",
        "required": [
          "stage",
          "completed",
          "total"
        ],
        "properties": {
          "completed": {
            "type": "string",
            "description": "Units processed, as a decimal string."
          },
          "stage": {
            "$ref": "#/components/schemas/AssessStageView",
            "description": "Work currently running; percentages are local to this stage."
          },
          "total": {
            "type": [
              "string",
              "null"
            ],
            "description": "Total units for this stage; null when unknown."
          }
        },
        "additionalProperties": false
      },
      "AssessStageView": {
        "type": "string",
        "description": "Current assessment work. Each stage has its own units and total.",
        "enum": [
          "inventory",
          "markers",
          "evidence",
          "graph",
          "deciding",
          "describing"
        ]
      },
      "CandidateView": {
        "type": "object",
        "description": "One assessed candidate.",
        "required": [
          "path",
          "verdict",
          "reclaimable_bytes",
          "reasons",
          "tool_command",
          "group",
          "ai_note"
        ],
        "properties": {
          "ai_note": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/AiNoteView",
                "description": "What AI review says a review item most likely is (ADR-0041): a note\nfor people, labelled as AI, that never changes the verdict. `null`\nunless the item is under review and AI review described it."
              },
              {
                "type": "null"
              }
            ]
          },
          "group": {
            "$ref": "#/components/schemas/GroupView",
            "description": "The group it is presented in."
          },
          "path": {
            "type": "string",
            "description": "Where it is."
          },
          "reasons": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ReasonView"
            },
            "description": "Why: one reason per policy rule that fired, in the policy's order."
          },
          "reclaimable_bytes": {
            "type": "string",
            "description": "What removing it would free now, in bytes."
          },
          "tool_command": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/ToolCommandView",
                "description": "The cleanup command of the developer tool that owns it, if the tool\nhas one: displayed in full and run by entry ID after desktop confirmation."
              },
              {
                "type": "null"
              }
            ]
          },
          "verdict": {
            "$ref": "#/components/schemas/VerdictView",
            "description": "The policy's verdict."
          }
        }
      },
      "ConfidenceView": {
        "type": "string",
        "description": "How sure AI review was.",
        "enum": [
          "low",
          "medium",
          "high"
        ]
      },
      "DiskView": {
        "type": "object",
        "description": "How full the disk holding the user's home folder is.",
        "required": [
          "total_bytes",
          "available_bytes"
        ],
        "properties": {
          "available_bytes": {
            "type": "string",
            "description": "The bytes the user may still write, in bytes."
          },
          "total_bytes": {
            "type": "string",
            "description": "The volume's size, in bytes."
          }
        }
      },
      "ExecuteRequest": {
        "type": "object",
        "description": "A request to execute a plan: its ID and, as the confirmation, its full\nhash.",
        "required": [
          "plan",
          "confirmation"
        ],
        "properties": {
          "confirmation": {
            "type": "string",
            "description": "The plan's full hash, as shown."
          },
          "plan": {
            "type": "string",
            "description": "The plan's ID."
          }
        },
        "additionalProperties": false
      },
      "FailureView": {
        "type": "string",
        "description": "Why moving an item failed.",
        "enum": [
          "identity_mismatch",
          "in_use",
          "volume_unsupported",
          "move_failed",
          "verification_failed",
          "other"
        ]
      },
      "FinalizeOutcomeView": {
        "type": "object",
        "description": "What a finalization did to one held item.",
        "required": [
          "operation",
          "original",
          "outcome"
        ],
        "properties": {
          "operation": {
            "type": "string",
            "description": "The operation."
          },
          "original": {
            "type": [
              "string",
              "null"
            ],
            "description": "Where the item was, if known."
          },
          "outcome": {
            "$ref": "#/components/schemas/FinalizeView",
            "description": "What happened."
          }
        }
      },
      "FinalizeView": {
        "oneOf": [
          {
            "type": "object",
            "description": "Removed for good.",
            "required": [
              "kind"
            ],
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "finalized"
                ]
              }
            }
          },
          {
            "type": "object",
            "description": "Back at its original place already; nothing removed.",
            "required": [
              "kind"
            ],
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "found_at_source"
                ]
              }
            }
          },
          {
            "type": "object",
            "description": "Not in the store; nothing removed.",
            "required": [
              "kind"
            ],
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "not_found"
                ]
              }
            }
          },
          {
            "type": "object",
            "description": "The removal stopped part way.",
            "required": [
              "removed",
              "kind"
            ],
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "failed"
                ]
              },
              "removed": {
                "$ref": "#/components/schemas/RemovedView",
                "description": "How much is gone."
              }
            }
          },
          {
            "type": "object",
            "description": "It may be in use, or that cannot be checked; nothing removed.",
            "required": [
              "kind"
            ],
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "maybe_in_use"
                ]
              }
            }
          },
          {
            "type": "object",
            "description": "Not retained; nothing done.",
            "required": [
              "kind"
            ],
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "not_finalizable"
                ]
              }
            }
          }
        ],
        "description": "What a finalization did."
      },
      "GroupKindView": {
        "type": "string",
        "description": "The kind of group an item is presented in.",
        "enum": [
          "developer",
          "app_cache",
          "app_data",
          "other"
        ]
      },
      "GroupView": {
        "type": "object",
        "description": "The group an item is presented in, and what it belongs to when known.",
        "required": [
          "kind",
          "source"
        ],
        "properties": {
          "kind": {
            "$ref": "#/components/schemas/GroupKindView",
            "description": "The kind of group."
          },
          "source": {
            "type": [
              "string",
              "null"
            ],
            "description": "The developer tool (e.g. `Xcode`) or the owning application's\nidentifier, as untrusted display text; `null` when unknown."
          }
        }
      },
      "HeldItemView": {
        "type": "object",
        "description": "One item in quarantine.",
        "required": [
          "operation",
          "state",
          "original",
          "since",
          "reclaim_bytes"
        ],
        "properties": {
          "operation": {
            "type": "string",
            "description": "The operation that moved it."
          },
          "original": {
            "type": [
              "string",
              "null"
            ],
            "description": "Where it was, if known."
          },
          "reclaim_bytes": {
            "type": [
              "string",
              "null"
            ],
            "description": "What removing it for good would free, in bytes, as the confirmed plan\nestimated; `null` for items quarantined before sizes were recorded."
          },
          "since": {
            "type": "string",
            "format": "date-time",
            "description": "When it was quarantined."
          },
          "state": {
            "$ref": "#/components/schemas/HeldStateView",
            "description": "Why it is held."
          }
        }
      },
      "HeldStateView": {
        "type": "string",
        "description": "Why an item is held.",
        "enum": [
          "retained",
          "held_after_failure"
        ]
      },
      "ItemKindView": {
        "type": "string",
        "description": "What kind of item AI review says a review item most likely is.",
        "enum": [
          "app_settings",
          "user_documents",
          "cache",
          "logs",
          "downloads_or_installers",
          "developer_tool_data",
          "backup_or_archive",
          "unknown"
        ]
      },
      "ItemReportView": {
        "type": "object",
        "description": "One planned item and what became of it.",
        "required": [
          "path",
          "reclaimable_bytes",
          "result"
        ],
        "properties": {
          "path": {
            "type": "string",
            "description": "Where it was."
          },
          "reclaimable_bytes": {
            "type": "string",
            "description": "What it would free, as planned, in bytes."
          },
          "result": {
            "$ref": "#/components/schemas/ItemResultView",
            "description": "What happened."
          }
        }
      },
      "ItemResultView": {
        "oneOf": [
          {
            "type": "object",
            "description": "Not moved; it is `REVIEW` at most now.",
            "required": [
              "reason",
              "kind"
            ],
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "skipped"
                ]
              },
              "reason": {
                "$ref": "#/components/schemas/SkipView",
                "description": "Why."
              }
            }
          },
          {
            "type": "object",
            "description": "Moved into quarantine, restorable.",
            "required": [
              "operation",
              "kind"
            ],
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "quarantined"
                ]
              },
              "operation": {
                "type": "string",
                "description": "The operation, for restoring or finalizing it."
              }
            }
          },
          {
            "type": "object",
            "description": "The move failed.",
            "required": [
              "reason",
              "left",
              "kind"
            ],
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "failed"
                ]
              },
              "left": {
                "$ref": "#/components/schemas/LocationView",
                "description": "Where the item is."
              },
              "reason": {
                "$ref": "#/components/schemas/FailureView",
                "description": "Why."
              }
            }
          }
        ],
        "description": "What became of one planned item."
      },
      "LocationView": {
        "type": "string",
        "description": "Where an item is after a failure.",
        "enum": [
          "source",
          "quarantine",
          "gone"
        ]
      },
      "NotRestoredView": {
        "type": "string",
        "description": "Why a restore did not happen.",
        "enum": [
          "name_taken",
          "origin_unreachable",
          "item_changed",
          "failed"
        ]
      },
      "PlanView": {
        "type": "object",
        "description": "A cleanup plan, waiting for confirmation.",
        "required": [
          "plan",
          "hash",
          "created_at",
          "items"
        ],
        "properties": {
          "created_at": {
            "type": "string",
            "format": "date-time",
            "description": "When it was made; it expires 24 hours later."
          },
          "hash": {
            "type": "string",
            "description": "Its full hash: the confirmation the user gives to execute it."
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CandidateView"
            },
            "description": "Its items, each with what it would free and why."
          },
          "plan": {
            "type": "string",
            "description": "The plan's ID."
          }
        }
      },
      "QuarantineReportView": {
        "type": "object",
        "description": "What executing a plan did.",
        "required": [
          "plan",
          "resolved",
          "items",
          "moved_bytes",
          "warnings"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ItemReportView"
            },
            "description": "Each item, in plan order."
          },
          "moved_bytes": {
            "type": "string",
            "description": "What the quarantined items will free once finalized, in bytes."
          },
          "plan": {
            "type": "string",
            "description": "The plan."
          },
          "resolved": {
            "type": "string",
            "description": "Interrupted operations from earlier runs that were resolved first."
          },
          "warnings": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Problems that did not stop the execution."
          }
        }
      },
      "ReasonView": {
        "type": "object",
        "description": "One policy rule that fired, and its fixed sentence (ADR-0014).",
        "required": [
          "rule",
          "text"
        ],
        "properties": {
          "rule": {
            "type": "string",
            "description": "The rule's stable identifier, such as `classify.devkb-regenerable`, so\nan interface can show the reason in the user's language."
          },
          "text": {
            "type": "string",
            "description": "The reason in English."
          }
        }
      },
      "RemovedView": {
        "type": "string",
        "description": "How much a failed removal took.",
        "enum": [
          "nothing",
          "partly",
          "item"
        ]
      },
      "RestoreOutcomeView": {
        "type": "object",
        "description": "What a restore did to one held item.",
        "required": [
          "operation",
          "original",
          "outcome"
        ],
        "properties": {
          "operation": {
            "type": "string",
            "description": "The operation."
          },
          "original": {
            "type": [
              "string",
              "null"
            ],
            "description": "Where the item was, if known."
          },
          "outcome": {
            "$ref": "#/components/schemas/RestoreView",
            "description": "What happened."
          }
        }
      },
      "RestoreView": {
        "oneOf": [
          {
            "type": "object",
            "description": "Back at its original place.",
            "required": [
              "parent_replaced",
              "verified",
              "kind"
            ],
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "restored"
                ]
              },
              "parent_replaced": {
                "type": "boolean",
                "description": "Its folder had been recreated since."
              },
              "verified": {
                "type": "boolean",
                "description": "It matched its record after the move."
              }
            }
          },
          {
            "type": "object",
            "description": "Still in quarantine.",
            "required": [
              "reason",
              "kind"
            ],
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "not_restored"
                ]
              },
              "reason": {
                "$ref": "#/components/schemas/NotRestoredView",
                "description": "Why."
              }
            }
          },
          {
            "type": "object",
            "description": "Not in a state that can be restored; nothing was done.",
            "required": [
              "kind"
            ],
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "not_restorable"
                ]
              }
            }
          }
        ],
        "description": "What a restore did."
      },
      "RootView": {
        "type": "object",
        "description": "What a scan found below one root.",
        "required": [
          "root",
          "files",
          "logical_bytes",
          "allocated_bytes",
          "reclaimable_bytes",
          "reclaimable_exact",
          "coverage_complete",
          "denied",
          "failed",
          "not_scanned"
        ],
        "properties": {
          "allocated_bytes": {
            "type": "string",
            "description": "Their allocated size in bytes."
          },
          "coverage_complete": {
            "type": "boolean",
            "description": "Whether everything below it could be read. If not, every size here is\na lower bound."
          },
          "denied": {
            "type": "string",
            "description": "Entries access was denied to."
          },
          "failed": {
            "type": "string",
            "description": "Entries that could not be read for other reasons."
          },
          "files": {
            "type": "string",
            "description": "Files below it."
          },
          "logical_bytes": {
            "type": "string",
            "description": "Their logical size in bytes."
          },
          "not_scanned": {
            "type": "string",
            "description": "Entries not scanned."
          },
          "reclaimable_bytes": {
            "type": "string",
            "description": "What removing everything below it would free now, in bytes."
          },
          "reclaimable_exact": {
            "type": "boolean",
            "description": "Whether `reclaimable_bytes` is exact rather than a lower bound."
          },
          "root": {
            "type": "string",
            "description": "The root."
          }
        }
      },
      "ScanProgressView": {
        "type": "object",
        "description": "A running scan's totals so far, sent a few times a second while it runs.",
        "required": [
          "entries",
          "directories",
          "allocated_bytes",
          "unreadable",
          "current",
          "elapsed_ms"
        ],
        "properties": {
          "allocated_bytes": {
            "type": "string",
            "description": "Disk space the files seen so far take up, in bytes."
          },
          "current": {
            "type": [
              "string",
              "null"
            ],
            "description": "The folder listed most recently, if any."
          },
          "directories": {
            "type": "string",
            "description": "Folders listed so far."
          },
          "elapsed_ms": {
            "type": "string",
            "description": "Milliseconds since the scan started."
          },
          "entries": {
            "type": "string",
            "description": "Entries seen so far."
          },
          "unreadable": {
            "type": "string",
            "description": "Folders that could not be read so far."
          }
        }
      },
      "ScanRequest": {
        "type": "object",
        "description": "A request to scan the given roots, read-only.",
        "required": [
          "roots"
        ],
        "properties": {
          "roots": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "The folders to scan, as the user chose them. Empty means the whole\nstartup disk (`lumen_app::roots::whole_disk`)."
          }
        },
        "additionalProperties": false
      },
      "ScanView": {
        "type": "object",
        "description": "What a scan found.",
        "required": [
          "scan",
          "roots",
          "entries",
          "partial",
          "out_of_space"
        ],
        "properties": {
          "entries": {
            "type": "string",
            "description": "Entries seen."
          },
          "out_of_space": {
            "type": "boolean",
            "description": "Whether it stopped because the disk holding the database was nearly\nfull; then `partial` is true too."
          },
          "partial": {
            "type": "boolean",
            "description": "Whether the scan stopped early (cancelled), so results are partial."
          },
          "roots": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RootView"
            },
            "description": "Each root."
          },
          "scan": {
            "type": "string",
            "description": "The scan's ID."
          }
        }
      },
      "SkipView": {
        "type": "string",
        "description": "Why a planned item was not moved.",
        "enum": [
          "changed",
          "outside_roots",
          "now_keep",
          "now_review",
          "reasons_changed",
          "not_prepared",
          "manifest"
        ]
      },
      "ToolCommandView": {
        "type": "object",
        "description": "A developer tool's own cleanup command, as a literal argument vector:\nshown in full, with desktop execution by entry ID after confirmation.",
        "required": [
          "entry",
          "tool",
          "program",
          "args",
          "removes_data"
        ],
        "properties": {
          "args": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Its arguments, one per element, unquoted."
          },
          "entry": {
            "type": "string",
            "description": "The knowledge-base entry it comes from: the name to run it by\n(ADR-0049); the page never sends the command itself."
          },
          "program": {
            "type": "string",
            "description": "The program, such as `xcrun`."
          },
          "removes_data": {
            "type": "boolean",
            "description": "It removes data, not just caches (Docker), so the confirmation says\nwhat it removes."
          },
          "tool": {
            "type": "string",
            "description": "The tool's display name, such as `Xcode`."
          }
        }
      },
      "ToolRunView": {
        "type": "object",
        "description": "How running a tool's command ended (ADR-0049).",
        "required": [
          "success",
          "exit_code",
          "timed_out",
          "output"
        ],
        "properties": {
          "exit_code": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32",
            "description": "Its exit code, if it exited on its own."
          },
          "output": {
            "type": "string",
            "description": "The end of what it printed."
          },
          "success": {
            "type": "boolean",
            "description": "It exited with status 0."
          },
          "timed_out": {
            "type": "boolean",
            "description": "It ran past the time limit and was stopped."
          }
        }
      },
      "UpdateView": {
        "type": "object",
        "description": "The app's version and whether a newer one is published (ADR-0048).",
        "required": [
          "current",
          "available",
          "installable"
        ],
        "properties": {
          "available": {
            "type": [
              "string",
              "null"
            ],
            "description": "The newer version on offer, if any."
          },
          "current": {
            "type": "string",
            "description": "The running version, such as `0.4.0`."
          },
          "installable": {
            "type": "boolean",
            "description": "Whether the app can install it itself; `false` where it cannot\nreplace its own files (a `.deb` install), which updates through the\ndownload page instead."
          }
        }
      },
      "VerdictView": {
        "type": "string",
        "description": "The policy's verdict.",
        "enum": [
          "keep",
          "review",
          "quarantine"
        ]
      }
    }
  }
}
