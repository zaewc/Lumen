{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Relationship",
  "description": "A typed, directed edge justified by evidence.",
  "type": "object",
  "properties": {
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/EvidenceId"
      },
      "uniqueItems": true
    },
    "from": {
      "$ref": "#/$defs/Subject"
    },
    "kind": {
      "$ref": "#/$defs/RelationKind"
    },
    "to": {
      "$ref": "#/$defs/Subject"
    }
  },
  "required": [
    "from",
    "kind",
    "to",
    "evidence"
  ],
  "$defs": {
    "AppId": {
      "description": "One identifier of an application under a given scheme.",
      "type": "object",
      "properties": {
        "scheme": {
          "description": "Identifier scheme.",
          "$ref": "#/$defs/AppIdScheme"
        },
        "value": {
          "description": "Identifier value as reported by the platform.",
          "$ref": "#/$defs/UntrustedText"
        }
      },
      "required": [
        "scheme",
        "value"
      ]
    },
    "AppIdScheme": {
      "description": "How an application identifier is defined.",
      "oneOf": [
        {
          "description": "Apple bundle identifier (`com.example.App`).",
          "type": "string",
          "const": "bundle_id"
        },
        {
          "description": "Android package name.",
          "type": "string",
          "const": "android_package"
        },
        {
          "description": "MSIX/AppX package family name.",
          "type": "string",
          "const": "msix_family"
        },
        {
          "description": "Windows Installer product code.",
          "type": "string",
          "const": "msi_product_code"
        },
        {
          "description": "Windows `Uninstall` registry key name.",
          "type": "string",
          "const": "uninstall_key"
        }
      ]
    },
    "EvidenceId": {
      "type": "string",
      "pattern": "^b3:[0-9a-f]{64}$"
    },
    "FileId": {
      "description": "Unsigned 128-bit file identifier as a canonical decimal string.",
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,38})$"
    },
    "FileIdentity": {
      "description": "The identity of a filesystem object: which volume, and which file on it.\n\nLumen keys every decision on identity rather than path text (ADR-0013,\nADR-0016), because paths can be swapped, normalised differently, or hard-linked.",
      "type": "object",
      "properties": {
        "file": {
          "description": "File identifier within the volume.",
          "$ref": "#/$defs/FileId"
        },
        "volume": {
          "description": "Volume holding the file.",
          "$ref": "#/$defs/VolumeId"
        }
      },
      "required": [
        "volume",
        "file"
      ]
    },
    "RelationKind": {
      "description": "Kind of relationship. Read `from <kind> to`, e.g. \"cache `owned_by` app\".",
      "oneOf": [
        {
          "description": "A directory or volume contains a file or directory.",
          "type": "string",
          "const": "contains"
        },
        {
          "description": "A file belongs to an application (by location convention, receipt or\nknowledge base).",
          "type": "string",
          "const": "owned_by"
        },
        {
          "description": "A file was created by an application.",
          "type": "string",
          "const": "created_by"
        },
        {
          "description": "A file is open in, or mapped by, a running process.",
          "type": "string",
          "const": "opened_by"
        },
        {
          "description": "A process was started by a service.",
          "type": "string",
          "const": "launched_by"
        },
        {
          "description": "A service runs this executable.",
          "type": "string",
          "const": "launches"
        },
        {
          "description": "A vendor declared this file a disposable cache of an application.",
          "type": "string",
          "const": "declared_cache_of"
        },
        {
          "description": "Two files share blocks (APFS or `ReFS` clones).",
          "type": "string",
          "const": "clone_of"
        },
        {
          "description": "Two files have identical content (confirmed by content hash).",
          "type": "string",
          "const": "duplicate_of"
        },
        {
          "description": "A file's content lives inside another file (e.g. container layers in a\nvirtual-machine disk image).",
          "type": "string",
          "const": "stored_in"
        }
      ]
    },
    "ServiceKind": {
      "description": "Kind of background or startup component.",
      "oneOf": [
        {
          "description": "macOS launchd agent (per user).",
          "type": "string",
          "const": "launch_agent"
        },
        {
          "description": "macOS launchd daemon (system).",
          "type": "string",
          "const": "launch_daemon"
        },
        {
          "description": "macOS login item or background item (Background Task Management).",
          "type": "string",
          "const": "login_item"
        },
        {
          "description": "Windows service.",
          "type": "string",
          "const": "windows_service"
        },
        {
          "description": "Windows driver.",
          "type": "string",
          "const": "driver"
        },
        {
          "description": "Windows Task Scheduler task.",
          "type": "string",
          "const": "scheduled_task"
        },
        {
          "description": "Windows `Run`/`RunOnce` value or Startup-folder entry.",
          "type": "string",
          "const": "startup_entry"
        }
      ]
    },
    "Subject": {
      "description": "What a piece of evidence is about.",
      "oneOf": [
        {
          "description": "A filesystem object.",
          "type": "object",
          "properties": {
            "identity": {
              "description": "Identity of the object.",
              "$ref": "#/$defs/FileIdentity"
            },
            "type": {
              "type": "string",
              "const": "file"
            }
          },
          "required": [
            "type",
            "identity"
          ]
        },
        {
          "description": "An installed application.",
          "type": "object",
          "properties": {
            "id": {
              "description": "One identifier of the application.",
              "$ref": "#/$defs/AppId"
            },
            "type": {
              "type": "string",
              "const": "application"
            }
          },
          "required": [
            "type",
            "id"
          ]
        },
        {
          "description": "A volume.",
          "type": "object",
          "properties": {
            "id": {
              "description": "Volume identifier.",
              "$ref": "#/$defs/VolumeId"
            },
            "type": {
              "type": "string",
              "const": "volume"
            }
          },
          "required": [
            "type",
            "id"
          ]
        },
        {
          "description": "A running process. PIDs are reused, so the start time is part of the key\nwhenever the platform reports it.",
          "type": "object",
          "properties": {
            "pid": {
              "description": "Process ID.",
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            },
            "started_at": {
              "description": "Process start time.",
              "anyOf": [
                {
                  "$ref": "#/$defs/Timestamp"
                },
                {
                  "type": "null"
                }
              ]
            },
            "type": {
              "type": "string",
              "const": "process"
            }
          },
          "required": [
            "type",
            "pid"
          ]
        },
        {
          "description": "A background, startup or scheduled component.",
          "type": "object",
          "properties": {
            "kind": {
              "description": "Component kind.",
              "$ref": "#/$defs/ServiceKind"
            },
            "label": {
              "description": "Label, service name or task name.",
              "$ref": "#/$defs/UntrustedText"
            },
            "type": {
              "type": "string",
              "const": "service"
            }
          },
          "required": [
            "type",
            "kind",
            "label"
          ]
        }
      ]
    },
    "Timestamp": {
      "description": "Canonical RFC 3339 UTC, fraction without trailing zeros.",
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{0,8}[1-9])?Z$"
    },
    "UntrustedText": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string",
          "maxLength": 1024
        },
        "truncated": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "required": [
        "text"
      ]
    },
    "VolumeId": {
      "description": "Opaque platform volume identifier: 1-128 bytes of visible ASCII.",
      "type": "string",
      "pattern": "^[!-~]{1,128}$"
    }
  }
}
